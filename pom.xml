<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fludakit</groupId>
        <artifactId>fludakit-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>fluda-sql-init-parent</artifactId>
    <packaging>pom</packaging>

    <name>FluDa :: SQL Init</name>
    <description>SQL schema and data initialization for Jakarta EE / CDI applications.</description>
    <url>https://github.com/fludakit/sql-init</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/fludakit/sql-init.git</connection>
        <developerConnection>scm:git:ssh://github.com/fludakit/sql-init.git</developerConnection>
        <url>https://github.com/fludakit/sql-init</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>core</module>
        <module>config</module>
        <module>cdi</module>
    </modules>

    <properties>
        <h2.version>2.5.252</h2.version>
        <jboss-vfs.version>3.3.2.Final</jboss-vfs.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- SQL Init modules -->
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-sql-init-cdi</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- SQL Init specific dependencies -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss</groupId>
                <artifactId>jboss-vfs</artifactId>
                <version>${jboss-vfs.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Module-specific plugin configurations can be added here -->
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Module-specific profiles can be added here -->
    </profiles>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/fludakit/sql-init</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
